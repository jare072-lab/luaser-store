# Copia este archivo a .env.local y rellena los valores reales.
# .env.local nunca se sube a git (ver .gitignore) — este archivo sí, por eso
# no debe contener ningún secreto real.

# ── Shopify Storefront API ──────────────────────────────────────────────
# Dominio *.myshopify.com de la tienda (sin https://).
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=tu-tienda.myshopify.com

# Token del canal "Headless" (Shopify Admin → Configuración → Apps y canales
# de venta → Desarrollar apps → tu app → API de Storefront → Access token).
# Es público por diseño (se expone al navegador), pero SOLO permite leer
# catálogo y operar el carrito propio del visitante — nunca acciones de Admin.
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=tu_storefront_access_token

# Versión de la Storefront API (formato YYYY-MM). Revisa/actualiza cada
# trimestre según el calendario de versiones de Shopify.
SHOPIFY_STOREFRONT_API_VERSION=2025-01

# ── Webhook de revalidación (app/api/revalidate/route.ts) ──────────────
# "Client secret" del custom app (Shopify Admin → Desarrollar apps → tu app
# → Credenciales de API → "Client secret"). Firma cada webhook entrante;
# sin este valor correcto, /api/revalidate rechaza todas las peticiones.
SHOPIFY_WEBHOOK_SECRET=

# ── Sitio ────────────────────────────────────────────────────────────────
# URL pública y final del sitio (sin slash final). Se usa en sitemap.xml,
# robots.txt, canonical y Open Graph. En local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Analítica (opcional) ────────────────────────────────────────────────
# El sitio funciona sin estos tres — no se inyecta ningún script hasta que
# tengan valor. Rellénalos cuando tengas las cuentas reales de GA4 y Meta.

# ID de medición de GA4, formato G-XXXXXXXXXX.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ID del Meta Pixel (Events Manager → tu pixel → Configuración).
NEXT_PUBLIC_META_PIXEL_ID=

# Token de acceso de la Conversions API del mismo pixel (Events Manager →
# tu pixel → Configuración → Conversions API → Generar token de acceso).
META_CAPI_ACCESS_TOKEN=

# ── Solo para scripts de administración (no lo usa la app en runtime) ───
# Admin API token del mismo custom app (permisos de lectura/escritura de
# productos, colecciones y publicaciones). Úsalo únicamente en scripts que
# corras tú manualmente (p. ej. registrar webhooks, publicar productos al
# canal Headless) — nunca lo importes desde código de la app ni del cliente.
SHOPIFY_ADMIN_TOKEN=
